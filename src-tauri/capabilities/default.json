{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": [
    "main",
    "task-widget"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "dialog:default",
    "process:default",
    "updater:default",
    "notification:default"
  ]
}
